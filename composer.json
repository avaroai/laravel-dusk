{
    "name": "avaroai/laravel-dusk",
    "description": "Laravel Dusk with support for mocked services.",
    "keywords": ["laravel", "dusk", "testing"],
    "license": "MIT",
    "require": {
        "php": ">=8.5.0",
        "laravel/ai": ">=1.0.4",
        "laravel/dusk": ">=8.0.0",
        "laravel/framework": ">=13.0.0"
    },
    "autoload": {
        "psr-4" : {
            "AvaroAI\\LaravelDusk\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Testing\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AvaroAI\\LaravelDusk\\MockingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
